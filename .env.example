# Copy to .env. Every value here is optional: with none of them set the app
# runs on the scripted local agent, with no network and no audio hardware.

# --- credentials -------------------------------------------------------------
# Leave empty to run offline. A placeholder value counts as empty, so copying
# this file does not select the hosted path and then fail with a vendor 401.
GROQ_API_KEY=

# --- provider selection ------------------------------------------------------
# auto  pick the best provider that can actually run here
# llm:  groq | scripted
# stt:  groq | unavailable
# tts:  kokoro | silent
LLM_PROVIDER=auto
STT_PROVIDER=auto
TTS_PROVIDER=auto

# --- hosted model settings ---------------------------------------------------
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=30
SEED=0

# --- interface ---------------------------------------------------------------
# auto | text | voice — text skips ASR and TTS, voice forces the audio path
VOICE_IO=auto
# Play a real opening exchange through the engine on first load
SEED_DEMO_CALL=0

# --- latency -----------------------------------------------------------------
# Turns slower than this to their first token are flagged in the UI. Nothing
# fails; the point is that a regression becomes visible.
TURN_BUDGET_MS=1200

# --- speech synthesis (local audio path only) --------------------------------
KOKORO_VOICE=af_sky
KOKORO_LANG_CODE=a
ALLOW_FALLBACK_TTS=0
FALLBACK_TTS_TIMEOUT_S=30

# --- CLI cost estimate -------------------------------------------------------
LLM_PRICE_IN_PER_1K=0
LLM_PRICE_OUT_PER_1K=0
